{
  "name": "@red-cup-engineering/voice-audio-services-section",
  "version": "0.2.0",
  "type": "module",
  "description": "Service boundary for speech-bearing audio and operations specialized to human voice.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/voice-audio-engineering-services-section.git"
  },
  "exports": {
    ".": "./src/audiobook-edition.mjs",
    "./audiobook-edition": "./src/audiobook-edition.mjs",
    "./audioplay-model": "./src/audioplay-model.mjs",
    "./speech-script": "./src/speech-script.mjs",
    "./speech-script-schema": "./specifications/speech-script.schema.json"
  },
  "keywords": [
    "speech",
    "voice",
    "audio-processing"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none --test-reporter=tap test/*.test.mjs",
    "test:consumer": "node --test --test-isolation=none --test-reporter=tap test/consumer/*.test.mjs",
    "check": "node --check src/audiobook-edition.mjs && node --check src/audioplay-model.mjs && node --check src/source-anchor.mjs && node --check src/speech-script.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/json-services-section": "0.4.2-dev.270",
    "@red-cup-engineering/uri-services-section": "0.1.1"
  },
  "private": false,
  "files": [
    "package.json",
    "README*",
    "LICENSE*",
    "src",
    "specifications",
    "test",
    "docs/speech-script-qualification.md"
  ],
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
